railway {
  network_name: "Silver Meridian"
  operating_region: "North Corridor"
  dispatch_center {
    call_sign: "MILEPOST-7"
    control_port: 17420
    emergency_channel: "RM-452"
    overnight_schedule: false
  }
  maintenance_policy {
    inspection_interval_hours: 720
    spare_parts_catalog: "/opt/silver-meridian/catalog/parts.yaml"
    incident_archive: "/opt/silver-meridian/archive/incidents.ndjson"
  }
}

# EASTBOUND-314 (active service)
service {
  service_id: "EASTBOUND-314"
  route_name: "Harbor Loop"
  direction: DIRECTION_EAST
  priority: 2
  origin_station: "BRIAR-POINT"
  destination_station: "COPPER-FALLS"
  consist {
    locomotive {
      fleet_number: "M-882"
      model: "Mistral-8"
      traction_mode: TRACTION_ELECTRIC
      commissioned_year: 2018
    }
    passenger_cars: 6
    dining_car: true
    accessibility_car: false
  }
  timetable {
    departure_local: "06:40"
    arrival_local: "08:15"
    operating_days: "MONDAY,WEDNESDAY,FRIDAY"
    stops {
      station_code: "BRIAR-POINT"
      platform: 2
      dwell_minutes: 4
    }
    stops {
      station_code: "LANTERN-CROSS"
      platform: 1
      dwell_minutes: 3
    }
    stops {
      station_code: "COPPER-FALLS"
      platform: 4
      dwell_minutes: 0
    }
  }
  telemetry {
    gateway_address: "fd31:7c2e:9100::314"
    sample_period_seconds: 15
    certificate_bundle: "/opt/silver-meridian/telemetry/eastbound-314.pem"
  }
}

